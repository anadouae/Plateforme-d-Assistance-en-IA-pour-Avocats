# ─── Sanad Production Config ───
SECRET_KEY=change-me-to-a-64-char-random-string
ENVIRONMENT=development
DEBUG=true
SEED_DEMO_DATA=false

# PostgreSQL
DATABASE_URL=postgresql://lexhub:lexhub_secret@localhost:5432/lexhub
# En production VPS : POSTGRES_PASSWORD fort dans .env.vps (jamais sanad_secret).

# Frontend
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# Pipeline 4 couches (prod) :
# 1 compréhension → 2 retrieval (corpus/web) → 3 LLM cloud rédige → 4 garde-fous
# Cerveau chat : auto | groq | kimi  (ollama = fallback local seulement)
LLM_PROVIDER=auto
LLM_CHAT_CLOUD_FIRST=true
LLM_ALLOW_CLOUD_FALLBACK=true
LLM_CHAT_USE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=lexhub-legal
OLLAMA_SYNTHESIS_MODEL=mistral
OLLAMA_CHAT_TIMEOUT=120

# Speech-to-text local (plaidoirie VPS)
WHISPER_ENABLED=true
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Cloud cerveau — free-tier rotation (si un provider est en 429 → suivant)
LLM_USE_FREE_ROUTER=true
GROQ_API_KEY=
# Fallback STT cloud si Whisper local KO (gratuit / rapide)
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
LLM_USE_GROQ_FOR_CHAT=true
LLM_USE_GROQ_FOR_WEB=true

# Kimi (Moonshot)
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.6

# Free tiers optionnels (recommandé pour éviter les 429)
# Gemini: https://ai.google.dev
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# DeepSeek: https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Together: https://together.ai
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
# SambaNova: https://cloud.sambanova.ai
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct

# Redis + Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# MinIO object storage
USE_MINIO=true
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=lexhub_minio
MINIO_SECRET_KEY=lexhub_minio_secret
MINIO_BUCKET=lexhub-documents
MINIO_SECURE=false

# ChromaDB + embeddings
CHROMA_PERSIST_DIR=./data/chromadb
EMBEDDING_MODEL=BAAI/bge-m3

# OCR : cloud d'abord (qualité max + rapide), Tesseract = secours
OCR_CLOUD_ENABLED=true
OCR_CLOUD_TIMEOUT_SEC=120
MISTRAL_OCR_MODEL=mistral-ocr-latest
OCR_DPI=300
MAX_PDF_OCR_PAGES=80
MAX_PDF_TESSERACT_PAGES=40
OCR_TESSERACT_TIMEOUT_SEC=480

# Web search (duckduckgo | tavily)
WEB_SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=

# Email — PROD : Resend (recommandé) | DEV : MailHog (localhost:1025)
RESEND_API_KEY=
EMAIL_FROM=LexHub <noreply@lexhub.space>

# SMTP — fallback dev uniquement
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=LexHub <noreply@lexhub.space>
SMTP_TLS=false
# Prod legacy SMTP (préférer Resend) :
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASSWORD=...
# SMTP_TLS=true

# Cloudflare Turnstile (CAPTCHA après échecs de login) — OBLIGATOIRE en production
# Créer un widget : https://dash.cloudflare.com → Turnstile → Add site
# Domaine = celui de l'app (ex. sanad.exemple.ma)
# En local/dev : laisser vide OU utiliser les clés de test Cloudflare
#   Site:   1x00000000000000000000AA
#   Secret: 1x0000000000000000000000000000000AA
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
BILLING_TRIAL_DAYS=14
BILLING_PAYMENT_MOCK=true

# Paiement Maroc (virement ICE + prépa CMI/PayZone)
LEXHUB_BANK_RIB=
LEXHUB_BANK_NAME=Attijariwafa Bank
LEXHUB_BANK_BENEFICIARY=WEBVOICE SARL
LEXHUB_COMPANY_ICE=
CMI_ENABLED=false
CMI_MERCHANT_ID=
CMI_STORE_KEY=
CMI_GATEWAY_URL=
PAYZONE_ENABLED=false
PAYZONE_MERCHANT_ID=
PAYZONE_API_KEY=
