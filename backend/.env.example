# ─── Sanad Production Config ───
SECRET_KEY=change-me-to-a-64-char-random-string
ENVIRONMENT=development
DEBUG=true
SEED_DEMO_DATA=false

# PostgreSQL
DATABASE_URL=postgresql://sanad:sanad_secret@localhost:5432/sanad

# Frontend
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# Pipeline 4 couches (prod) :
# 1 compréhension → 2 retrieval (corpus/web) → 3 LLM cloud rédige → 4 garde-fous
# Cerveau chat : auto | groq | kimi  (ollama = fallback local seulement)
LLM_PROVIDER=auto
LLM_CHAT_CLOUD_FIRST=true
LLM_ALLOW_CLOUD_FALLBACK=true
LLM_CHAT_USE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=sanad-legal
OLLAMA_SYNTHESIS_MODEL=mistral
OLLAMA_CHAT_TIMEOUT=120

# Speech-to-text local (plaidoirie VPS)
WHISPER_ENABLED=true
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Cloud cerveau — free-tier rotation (si un provider est en 429 → suivant)
LLM_USE_FREE_ROUTER=true
GROQ_API_KEY=
LLM_USE_GROQ_FOR_CHAT=true
LLM_USE_GROQ_FOR_WEB=true

# Kimi (Moonshot)
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.6

# Free tiers optionnels (recommandé pour éviter les 429)
# Gemini: https://ai.google.dev
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# DeepSeek: https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Together: https://together.ai
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
# SambaNova: https://cloud.sambanova.ai
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct

# Redis + Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# MinIO object storage
USE_MINIO=true
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=sanad_minio
MINIO_SECRET_KEY=sanad_minio_secret
MINIO_BUCKET=sanad-documents
MINIO_SECURE=false

# ChromaDB + BGE-M3 embeddings
CHROMA_PERSIST_DIR=./data/chromadb
EMBEDDING_MODEL=BAAI/bge-m3

# Web search (duckduckgo | tavily)
WEB_SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=

# SMTP (Mailhog dev: localhost:1025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Sanad <noreply@sanad.ma>
SMTP_TLS=false

# Cloudflare Turnstile (CAPTCHA après échecs de login)
# Créer un widget sur https://dash.cloudflare.com → Turnstile
# En local : laisser vide (CAPTCHA désactivé)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
