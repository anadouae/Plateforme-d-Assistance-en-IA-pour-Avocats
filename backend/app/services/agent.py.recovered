import json
import logging
from concurrent.futures import ThreadPoolExecutor
from dataclasses import dataclass

from app.core.config import settings
from app.schemas import Citation
from app.services.rag import search_case_documents, search_document_by_id, search_legal_corpus, is_ohada_question
from app.services.corpus_graph import find_graph_for_hits
from app.services.web_search import search_web, search_web_for_recent_laws
from app.services.citation_urls import resolve_citation_url
from app.services.reforms_corpus import search_reforms

logger = logging.getLogger(__name__)


@dataclass
class AgentResult:
    answer: str
    source_type: str
    sources: list[Citation]
    confidence_score: int
    summary: str = ""


def _enrich_citations(citations: list[Citation]) -> list[Citation]:
    return [
        Citation(
            label=c.label,
            excerpt=c.excerpt,
            url=c.url or resolve_citation_url(c.label, c.excerpt),
        )
        for c in citations
    ]


def _with_urls(result: AgentResult) -> AgentResult:
    if not result.sources:
        return result
    return AgentResult(
        answer=result.answer,
        source_type=result.source_type,
        sources=_enrich_citations(result.sources),
        confidence_score=result.confidence_score,
        summary=result.summary,
    )


def _hits_to_citations(hits: list[dict]) -> list[Citation]:
    out: list[Citation] = []
    for h in hits:
        label = h["source"]
        excerpt = h["text"][:300]
        out.append(
            Citation(
                label=label,
                excerpt=excerpt,
                url=resolve_citation_url(label, excerpt),
            )
        )
    return out


def _merge_citations(*groups: list[Citation]) -> list[Citation]:
    seen: set[str] = set()
    merged: list[Citation] = []
    for group in groups:
        for c in group:
            key = c.label.strip().lower()
            if key and key not in seen:
                seen.add(key)
                merged.append(c)
    return merged


def _sources_text(citations: list[Citation], hits: list[dict] | None = None) -> str:
    parts: list[str] = []
    if hits:
        for h in hits[:5]:
            parts.append(f"[CORPUS — {h['source']}] {h['text'][:500]}")
    for c in citations:
        parts.append(f"[{c.label}] {c.excerpt}")
    return "\n\n".join(parts)


def _synthesize_from_sources(
    question: str,
    citations: list[Citation],
    source_type: str,
    confidence: int,
    language: str = "fr",
    hits: list[dict] | None = None,
    extra_sources_text: str = "",
    custom_prompt: str | None = None,
    llm_provider: str | None = None,
) -> AgentResult | None:
    from app.services.local_llm import synthesize_structured_answer_sync

    if not citations and not extra_sources_text:
        return None

    text = extra_sources_text
    body = _sources_text(citations, hits=hits)
    if body:
        text = f"{text}\n\n{body}".strip() if text else body

    structured = synthesize_structured_answer_sync(
        question,
        text,
        language=language,
        custom_prompt=custom_prompt,
        llm_provider=llm_provider,
    )
    if structured:
        return AgentResult(
            answer=structured["answer"],
            source_type=source_type,
            sources=citations,
            confidence_score=min(92, confidence + 12),
            summary=structured.get("summary", ""),
        )

    logger.warning("LLM synthesis failed for question (provider=%s)", llm_provider)
    return None


def direct_reforms_answer(
    citations: list[Citation],
    locale: str = "fr",
    year_filter: list[int] | None = None,
) -> tuple[str, str]:
    """Réponse directe sans LLM — secours uniquement."""
    if not citations:
        return "", ""

    if locale == "ar":
        intro = (
            f"الإصلاحات المغربية لسنة {year_filter[0]}:\n\n"
            if year_filter
            else "أبرز الإصلاحات والقوانين المغربية:\n\n"
        )
        summary_intro = "ملخص: "
        joiner = "\n"
    else:
        intro = (
            f"Textes législatifs marocains publiés en {year_filter[0]} :\n\n"
            if year_filter
            else "Principales réformes législatives marocaines :\n\n"
        )
        summary_intro = "En résumé : "
        joiner = "\n"

    lines = []
    for i, c in enumerate(citations, 1):
        lines.append(f"[{i}] {c.label} — {c.excerpt}")

    answer = intro + joiner.join(lines)
    summary = summary_intro + citations[0].excerpt
    if len(citations) > 1:
        summary += f" {'و' if locale == 'ar' else 'et'} {citations[1].label.split('—')[0].strip()}."
    return answer, summary


def _infer_source_type(has_corpus: bool, has_web: bool) -> str:
    if has_corpus and has_web:
        return "rag+web"
    if has_web:
        return "web"
    return "rag"

    if has_corpus and has_web:
        return "rag+web"
    if has_web:
        return "web"
    return "rag"


def _enhance_with_llm(question: str, result: AgentResult) -> AgentResult:
    from app.services.groq_llm import generate_from_sources_sync

    sources_text = "\n\n".join(f"[{s.label}] {s.excerpt}" for s in result.sources)
    if not sources_text:
        return result

    llm_answer = generate_from_sources_sync(question, sources_text)
    if llm_answer:
        return AgentResult(
            answer=llm_answer,
            source_type=result.source_type,
            sources=result.sources,
            confidence_score=min(95, result.confidence_score + 5),
        )
    return result


def answer_from_hits(
    question: str,
    hits: list[dict],
    source_type: str,
) -> AgentResult | None:
    if not hits:
        return None

    best_score = max(h["score"] for h in hits)
    citations = _hits_to_citations(hits)
    combined = "\n\n".join(f"**{h['source']}** : {h['text']}" for h in hits[:3])

    related_lines = []
    for h in hits[:2]:
        for rel in h.get("related_articles", [])[:3]:
            related_lines.append(f"- {rel['label']} ({rel.get('instrument', '')})")
    related_block = ""
    if related_lines:
        related_block = "\n\n**Articles liés (cartographie)** :\n" + "\n".join(related_lines)

    answer = (
        f"Voici les éléments pertinents trouvés pour votre question :\n\n{combined}"
        f"{related_block}\n\n"
        "Cette réponse est fondée exclusivement sur les sources identifiées ci-dessus."
    )
    return AgentResult(
        answer=answer,
        source_type=source_type,
        sources=citations,
        confidence_score=best_score,
    )


def answer_from_document_rag(
    question: str,
    cabinet_id: str,
    case_id: str,
    document_id: str,
    document_name: str,
    fallback_text: str = "",
    language: str = "fr",
    custom_prompt: str | None = None,
    llm_provider: str | None = None,
) -> AgentResult:
    from app.services.extraction import get_document_context_excerpt
    from app.services.language import get_disclaimer, msg_doc_not_found, normalize_locale
    from app.services.local_llm import generate_document_answer_sync

    locale = normalize_locale(language)
    text = fallback_text or ""

    llm_answer = generate_document_answer_sync(
        question,
        document_name,
        text,
        language=locale,
        llm_provider=llm_provider,
    )
    if llm_answer:
        excerpt = get_document_context_excerpt(text, question, max_len=500)
        return AgentResult(
            answer=llm_answer,
            source_type="document",
            sources=[Citation(label=document_name, excerpt=excerpt[:300] or text[:300])],
            confidence_score=88,
        )

    hits = search_document_by_id(cabinet_id, case_id, document_id, question)
    if hits:
        result = answer_from_hits(question, hits, "document")
        if result:
            return _enhance_with_llm(question, result, language=locale)

    if text:
        excerpt = get_document_context_excerpt(text, question, max_len=1200)
        if excerpt:
            doc_prefix = {
                "fr": f"D'après le document « {document_name} » :\n\n",
                "ar": f"وفقاً للوثيقة « {document_name} » :\n\n",
                "en": f"According to the document « {document_name} » :\n\n",
            }[locale]
            return AgentResult(
                answer=f"{doc_prefix}{excerpt}",
                source_type="document",
                sources=[Citation(label=document_name, excerpt=excerpt[:300])],
                confidence_score=65,
            )

    return AgentResult(
        answer=msg_doc_not_found(locale),
        source_type="document",
        sources=[],
        confidence_score=0,
    )


def answer_from_case_rag(
    question: str,
    cabinet_id: str,
    case_id: str,
    case_reference: str,
    language: str = "fr",
) -> AgentResult | None:
    hits = search_case_documents(cabinet_id, case_id, question)
    if not hits:
        return None
    result = answer_from_hits(question, hits, "document")
    if result:
        result = AgentResult(
            answer=result.answer.replace("sources identifiées", f"dossier {case_reference}"),
            source_type=result.source_type,
            sources=result.sources,
            confidence_score=result.confidence_score,
        )
        return _enhance_with_llm(question, result, language=language)
    return None


def answer_from_corpus_rag(
    question: str,
    threshold: int = 60,
    language: str = "fr",
    use_llm: bool = True,
) -> AgentResult | None:
    corpus_filter = "legal_corpus_ohada" if is_ohada_question(question) else None
    hits = search_legal_corpus(question, corpus_filter=corpus_filter)
    if not hits:
        return None
    hits = find_graph_for_hits(hits)
    best = hits[0]["score"]
    if best < 40:
        return None
    source_type = "ohada" if corpus_filter else "rag"
    result = answer_from_hits(question, hits, source_type)
    if not result:
        return None
    if use_llm and best >= threshold:
        return _enhance_with_llm(question, result, language=language)
    return result


def answer_from_web_search(
    question: str,
    language: str = "fr",
    recent: bool = False,
    custom_prompt: str | None = None,
    llm_provider: str | None = None,
) -> AgentResult | None:
    from app.services.language import normalize_locale
    from app.services.local_llm import synthesize_structured_answer_sync, synthesize_web_answer_sync

    locale = normalize_locale(language)
    if recent:
        text, citations, score = search_web_for_recent_laws(question, locale=locale)
    else:
        text, citations, score = search_web(question)

    if not citations:
        return None

    summary = ""
    structured = synthesize_structured_answer_sync(
        question,
        text,
        language=locale,
        custom_prompt=custom_prompt,
        llm_provider=llm_provider,
    )
    if structured:
        answer = structured["answer"]
        summary = structured.get("summary", "")
        confidence = min(82, max(score, 58) + 8)
    elif legacy := synthesize_web_answer_sync(question, text, language=locale):
        answer = (
            f"{legacy}\n\n"
            "**Sources web consultées :**\n"
            + "\n".join(f"- {c.label}" for c in citations[:6])
        )
        confidence = min(82, max(score, 58) + 8)
    else:
        answer = (
            "Recherche web — sources consultées :\n\n"
            f"{text[:2000]}\n\n"
            "Vérifiez chaque URL sur le Bulletin officiel (sgg.gov.ma) avant toute décision."
        )
        confidence = score

    return AgentResult(
        answer=answer,
        source_type="web",
        sources=citations,
        confidence_score=confidence,
        summary=summary,
    )


def _parallel_corpus_and_web(question: str, language: str = "fr") -> tuple[AgentResult | None, AgentResult | None]:
    """Run corpus RAG and web search in parallel for speed."""
    corpus_result: AgentResult | None = None
    web_result: AgentResult | None = None

    def _corpus():
        return answer_from_corpus_rag(question, threshold=40, language=language)

    def _web():
        return answer_from_web_search(question, language=language)

    with ThreadPoolExecutor(max_workers=2) as pool:
        f_corpus = pool.submit(_corpus)
        f_web = pool.submit(_web)
        try:
            corpus_result = f_corpus.result(timeout=8)
        except Exception as exc:
            logger.warning("Parallel corpus failed: %s", exc)
        try:
            web_result = f_web.result(timeout=10)
        except Exception as exc:
            logger.warning("Parallel web failed: %s", exc)

    return corpus_result, web_result


def _merge_hybrid(question: str, corpus_result: AgentResult, web_result: AgentResult, language: str = "fr") -> AgentResult:
    from app.services.local_llm import generate_from_sources_sync
    from app.services.language import normalize_locale

    locale = normalize_locale(language)
    corpus_text = "\n\n".join(f"[{s.label}] {s.excerpt}" for s in corpus_result.sources[:3])
    web_text = "\n\n".join(f"[{s.label}] {s.excerpt}" for s in web_result.sources[:3])
    combined_sources = f"CORPUS JURIDIQUE:\n{corpus_text}\n\nSOURCES WEB:\n{web_text}"

    llm_answer = generate_from_sources_sync(question, combined_sources, language=locale)
    if llm_answer:
        answer = (
            f"{llm_answer}\n\n**Références :** corpus Sanad indexé + sources web (URLs ci-dessous)."
        )
    else:
        answer = (
            f"**Fondement corpus juridique :**\n{corpus_result.answer}\n\n"
            f"**Complément web :**\n{web_result.answer}"
        )

    return AgentResult(
        answer=answer,
        source_type="rag+web",
        sources=corpus_result.sources + web_result.sources,
        confidence_score=max(corpus_result.confidence_score, web_result.confidence_score),
    )


def route_and_answer(
    question: str,
    document_text: str | None = None,
    document_name: str | None = None,
    document_id: str | None = None,
    cabinet_id: str | None = None,
    case_id: str | None = None,
    case_reference: str | None = None,
    excerpt: str | None = None,
    confidence_threshold: int = 60,
    language: str = "fr",
) -> AgentResult:
    from app.services.language import (
        is_greeting,
        is_recent_law_query,
        msg_greeting,
        msg_no_sources,
        msg_recent_laws_not_indexed,
        normalize_locale,
        resolve_response_language,
    )

    locale = resolve_response_language(question, language)

    if is_greeting(question):
        greet_locale = detect_language(question, fallback=locale)
        return AgentResult(answer=msg_greeting(greet_locale), source_type="system", sources=[], confidence_score=0)

    if is_unclear_question(question):
        return AgentResult(
            answer=msg_unclear_question(locale),
            source_type="system",
            sources=[],
            confidence_score=0,
        )

    year_filter = extract_year_filter(question)
    recent = is_recent_law_query(question)
        return answer_from_document_rag(
            question,
            cabinet_id,
            case_id,
            document_id,
            document_name,
            fallback_text=document_text or "",
            language=locale,
        )

    if case_id and cabinet_id and not document_id:
        case_result = answer_from_case_rag(
            question, cabinet_id, case_id, case_reference or case_id, language=locale
        )
        if case_result and case_result.confidence_score >= confidence_threshold:
            return case_result

    corpus_result, web_result = _parallel_corpus_and_web(question, language=locale)

    if corpus_result and corpus_result.confidence_score >= confidence_threshold:
        return corpus_result

    if corpus_result and corpus_result.confidence_score >= 40 and web_result and web_result.sources:
        return _merge_hybrid(question, corpus_result, web_result, language=locale)

    if web_result and web_result.sources:
        return web_result

    if corpus_result:
        return corpus_result

    return AgentResult(
        answer=msg_no_sources(locale),
        source_type="none",
        sources=[],
        confidence_score=0,
    )


def route_and_search(
    question: str,
    document_text: str | None = None,
    document_name: str | None = None,
    document_id: str | None = None,
    cabinet_id: str | None = None,
    case_id: str | None = None,
    case_reference: str | None = None,
    language: str = "fr",
    custom_prompt: str | None = None,
    llm_provider: str | None = None,
) -> AgentResult:
    """Recherche rapide sans appel LLM — pour le streaming."""
    from app.services.language import (
        detect_language,
        extract_year_filter,
        is_greeting,
        is_recent_law_query,
        is_unclear_question,
        msg_greeting,
        msg_no_laws_for_year,
        msg_no_sources,
        msg_recent_laws_not_indexed,
        msg_unclear_question,
        resolve_response_language,
        _has_substantive_legal_topic,
    )
    from app.services.rag import search_legal_corpus_fast

    locale = resolve_response_language(question, language)

    if is_greeting(question):
        greet_locale = detect_language(question, fallback=locale)
        return AgentResult(answer=msg_greeting(greet_locale), source_type="system", sources=[], confidence_score=0)

    if is_recent_law_query(question):
        web_result = answer_from_web_search(question, language=locale, recent=True)
        if web_result:
            return web_result
        hits = search_legal_corpus_fast(question)
        if hits:
            result = answer_from_hits(question, hits, "rag")
            if result and result.confidence_score >= 35:
                return result
        return AgentResult(
            answer=msg_recent_laws_not_indexed(locale),
            source_type="system",
            sources=[],
            confidence_score=0,
        )

    if document_id and cabinet_id and case_id and document_name:
        return answer_from_document_rag(
            question,
            cabinet_id,
            case_id,
            document_id,
            document_name,
            fallback_text=document_text or "",
            language=locale,
            custom_prompt=custom_prompt,
            llm_provider=llm_provider,
        )

    if case_id and cabinet_id and not document_id:
        hits = search_case_documents(cabinet_id, case_id, question)
        if hits:
            citations = _hits_to_citations(hits)
            synth = _synthesize_from_sources(
                question, citations, "document", max(h["score"] for h in hits), locale, hits=hits,
                custom_prompt=custom_prompt,
                llm_provider=llm_provider,
            )
            if synth:
                return synth
            result = answer_from_hits(question, hits, "document")
            if result:
                return result

    # Recherche parallèle : réformes récentes + web (+ corpus sauf requêtes « lois récentes »)
    corpus_hits: list[dict] = []
    web_citations: list[Citation] = []
    web_score = 0
    reforms_text = ""
    reforms_citations: list[Citation] = []
    reforms_score = 0

    def _fetch_corpus():
        nonlocal corpus_hits
        hits = search_legal_corpus_fast(question)
        if hits:
            corpus_hits = find_graph_for_hits(hits)

    def _fetch_web():
        nonlocal web_citations, web_score
        use_recent_web = recent and not _has_substantive_legal_topic(question)
        if use_recent_web:
            _, citations, score = search_web_for_recent_laws(question, locale=locale)
        else:
            _, citations, score = search_web(question)
        web_citations = citations
        web_score = score

    def _fetch_reforms():
        nonlocal reforms_text, reforms_citations, reforms_score
        if not recent and not year_filter:
            return
        reforms_text, reforms_citations, reforms_score = search_reforms(
            question, years_back=10, locale=locale, year_filter=year_filter
        )

    with ThreadPoolExecutor(max_workers=3) as pool:
        futures = [
            pool.submit(_fetch_corpus),
            pool.submit(_fetch_web),
            pool.submit(_fetch_reforms),
        ]
        for fut in futures:
            try:
                fut.result(timeout=15)
            except Exception as exc:
                logger.warning("Parallel search failed: %s", exc)

    corpus_citations = _hits_to_citations(corpus_hits) if corpus_hits else []
    all_citations = _merge_citations(reforms_citations, corpus_citations, web_citations)
    corpus_score = max((h["score"] for h in corpus_hits), default=0)
    confidence = max(corpus_score, web_score, reforms_score, 45 if all_citations else 0)
    has_reforms = bool(reforms_citations)
    has_web = bool(web_citations)
    has_corpus = bool(corpus_hits)
    if has_reforms and (has_web or has_corpus):
        source_type = "rag+web"
    elif has_reforms or has_web:
        source_type = "web" if has_web else "rag"
    else:
        source_type = _infer_source_type(has_corpus, has_web)

    if all_citations or reforms_text:
        synth = _synthesize_from_sources(
            question,
            all_citations,
            source_type,
            confidence,
            locale,
            hits=corpus_hits or None,
            extra_sources_text=reforms_text,
            custom_prompt=custom_prompt,
            llm_provider=llm_provider,
        )
        if synth:
            return synth

    if year_filter and not all_citations and not _has_substantive_legal_topic(question):
        web_result = answer_from_web_search(
            question,
            language=locale,
            recent=True,
            custom_prompt=custom_prompt,
            llm_provider=llm_provider,
        )
        if web_result:
            return web_result
        return AgentResult(
            answer=msg_no_laws_for_year(year_filter[0], locale),
            source_type="system",
            sources=[],
            confidence_score=0,
        )

    if corpus_hits:
        result = answer_from_hits(question, corpus_hits, "rag")
        if result and result.confidence_score >= 35:
            return result

    if web_citations:
        web_result = answer_from_web_search(
            question,
            language=locale,
            recent=recent,
            custom_prompt=custom_prompt,
            llm_provider=llm_provider,
        )
        if web_result:
            return web_result

    if is_recent_law_query(question):
        return AgentResult(
            answer=msg_recent_laws_not_indexed(locale),
            source_type="system",
            sources=[],
            confidence_score=0,
        )

    return AgentResult(
        answer=msg_no_sources(locale),
        source_type="none",
        sources=[],
        confidence_score=0,
    )


def generate_synthesis(document_name: str, text: str) -> dict:
    from app.services.extraction import (
        extract_amounts,
        extract_dates,
        extract_parties,
        extract_risk_clauses,
    )
    from app.services.groq_llm import generate_from_sources_sync

    if not text or len(text.strip()) < 20:
        return {
            "parties": [],
            "key_dates": [],
            "amounts": [],
            "risk_clauses": [],
            "attention_points": ["Texte insuffisant pour une synthèse fiable"],
            "summary": "Le document ne contient pas assez de texte extractible.",
            "sources": [],
        }

    parties = extract_parties(text)
    dates = extract_dates(text)
    amounts = extract_amounts(text)
    risks = extract_risk_clauses(text)
    preview = text[:800].replace("\n", " ")

    attention = []
    if not parties:
        attention.append("Parties non identifiées clairement — vérification manuelle recommandée")
    if not dates:
        attention.append("Aucune date clé détectée automatiquement")
    if risks:
        attention.append(f"{len(risks)} clause(s) à risque potentiel détectée(s)")

    summary = (
        f"Synthèse automatique du document « {document_name} ». "
        f"Extrait principal : {preview[:400]}..."
    )

    groq_summary = generate_from_sources_sync(
        f"Synthétise ce document juridique : {document_name}",
        preview,
    )
    if groq_summary:
        summary = groq_summary

    return {
        "parties": parties or ["Non identifiées automatiquement"],
        "key_dates": dates or ["Non détectées"],
        "amounts": amounts or ["Non détectés"],
        "risk_clauses": risks or ["Aucune clause à risque détectée"],
        "attention_points": attention or ["Synthèse générée avec succès"],
        "summary": summary,
        "sources": [Citation(label=document_name, excerpt=preview[:300])],
    }


def finalize_agent_result(result: AgentResult) -> AgentResult:
    return _with_urls(result)


def citations_to_json(sources: list[Citation]) -> str:
    return json.dumps([s.model_dump() for s in sources], ensure_ascii=False)
