# ═══════════════════════════════════════════════════════════════
#  SANAD — Variables d''environnement (exemple)
#  Copiez vers .env et renseignez vos clés.
# ═══════════════════════════════════════════════════════════════

# Laissez vide pour PostgreSQL Docker local, ou collez une URL cloud (Neon/Supabase)
DATABASE_URL=

# IA
GROQ_API_KEY=
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.6

WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

ENCRYPTION_KEY=

LLM_PROVIDER=mistral
LLM_CHAT_CLOUD_FIRST=true
LLM_ALLOW_CLOUD_FALLBACK=true

# Auth
SECRET_KEY=change-me-in-production
JWT_SECRET=change-me-in-production

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8001

# Whisper STT
WHISPER_ENABLED=true
WHISPER_MODEL=small
WHISPER_DEVICE=cpu

# Mail — DEV (MailHog)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=LexHub <noreply@lexhub.space>
SMTP_TLS=false

# Mail — PROD (Brevo gratuit : https://app.brevo.com)
# 1) Créer un compte Brevo → SMTP & API → SMTP
# 2) Vérifier le domaine lexhub.space (SPF + DKIM dans DNS)
# 3) Sur le VPS (/opt/sanad/.env) :
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=votre-login-brevo
# SMTP_PASSWORD=votre-cle-smtp-brevo
# SMTP_FROM=LexHub <noreply@lexhub.space>
# SMTP_TLS=true
# ENVIRONMENT=production

# Prod — Cloudflare Turnstile
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Paiement Maroc (virement ICE + prépa CMI/PayZone)
LEXHUB_BANK_RIB=
LEXHUB_BANK_NAME=Attijariwafa Bank
LEXHUB_BANK_BENEFICIARY=WEBVOICE SARL
LEXHUB_COMPANY_ICE=
CMI_ENABLED=false
CMI_MERCHANT_ID=
CMI_STORE_KEY=
CMI_GATEWAY_URL=
PAYZONE_ENABLED=false
PAYZONE_MERCHANT_ID=
PAYZONE_API_KEY=
