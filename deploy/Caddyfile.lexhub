lexhub.space, www.lexhub.space {
	encode gzip zstd

	# Sécurité HTTP (edge)
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(self), geolocation=(), payment=()"
		-Server
		-X-Powered-By
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8001
	}

	handle /health* {
		reverse_proxy 127.0.0.1:8001
	}

	# Adminer : localhost VPS only (127.0.0.1:8088) — PAS exposé sur HTTPS public.
	# Accès : tunnel SSH → http://127.0.0.1:8088

	@nextstatic path /_next/static/*
	header @nextstatic Cache-Control "public, max-age=31536000, immutable"

	@staticassets {
		path /videos/* /fonts/* *.mp4 *.png *.jpg *.jpeg *.webp *.ico *.svg *.woff2
	}
	header @staticassets Cache-Control "public, max-age=604800, stale-while-revalidate=86400"

	@html {
		not path /_next/* /videos/* /fonts/* *.mp4 *.png *.jpg *.jpeg *.webp *.ico *.svg *.woff2
	}
	header @html Cache-Control "no-store, must-revalidate"

	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
