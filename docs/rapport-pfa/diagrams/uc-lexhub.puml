@startuml uc-lexhub
skinparam shadowing false
skinparam packageStyle rectangle
left to right direction

actor "Avocat" as Avocat
actor "Admin cabinet" as AdminCab
actor "Assistant" as Asst
actor "Admin plateforme" as Plat

AdminCab --|> Avocat : hérite

rectangle "LexHub" {
  package "Atelier plaidoirie" {
    usecase "Gérer dossier\net pièces" as UC1
    usecase "Dicter / importer\naudio" as UC2
    usecase "Corriger la forme" as UC3
    usecase "Rédiger la\nplaidoirie" as UC4
    usecase "Valider le\nbrouillon" as UC5
    usecase "Assigner un\nassistant" as UC6
    usecase "Exporter Word\n(.docx) et PDF" as UC7
  }
  package "Espace cabinet" {
    usecase "Consulter\nplaidoiries validées" as UC8
    usecase "Inviter l'équipe" as UC9
    usecase "Gérer\nl'abonnement" as UC10
    usecase "Gérer le planning" as UC11
  }
  package "Supervision" {
    usecase "Vue usage\n& plans" as UC12a
    usecase "Suspendre /\npurger cabinet" as UC12
    usecase "Journal\nd'audit" as UC12b
    usecase "Coach\nexploitation" as UC12c
  }
}

Avocat --> UC1
Avocat --> UC2
Avocat --> UC3
Avocat --> UC4
Avocat --> UC5
Avocat --> UC6
Avocat --> UC7
Avocat --> UC11

UC2 ..> UC3 : <<include>>
UC6 ..> UC5 : <<include>>

Asst --> UC8
Asst --> UC7

AdminCab --> UC9
AdminCab --> UC10

Plat --> UC12a
Plat --> UC12
Plat --> UC12b
Plat --> UC12c
@enduml
