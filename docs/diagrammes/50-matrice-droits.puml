rectangle "Fonctionnalité" as F
rectangle "Avocat" as AV #0B1F4A
rectangle "Assistant" as AS #FFFFFF
rectangle "Admin cabinet" as AC #1a3a2a

note as N1
  | Fonction | Avocat | Assistant | Admin cab. |
  | Dicter plaidoirie | Oui | Non | Oui |
