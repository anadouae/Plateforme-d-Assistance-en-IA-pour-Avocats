@startuml deploy-lexhub
skinparam shadowing false
node "Client" {
  [Navigateur]
}
node "VPS lexhub.space" {
  [Caddy TLS] as Caddy
  [Frontend Next.js] as FE
  [Backend FastAPI] as BE
  database PostgreSQL
  queue Redis
  storage MinIO
}
cloud "Services cloud" {
  [STT API]
  [LLM API]
}
[Navigateur] --> Caddy
Caddy --> FE
Caddy --> BE
BE --> PostgreSQL
BE --> Redis
BE --> MinIO
BE --> [STT API]
BE --> [LLM API]
@enduml
