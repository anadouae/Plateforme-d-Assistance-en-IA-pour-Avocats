@startuml seq-assign
!theme plain
skinparam shadowing false
title Validation / assignation (alias de seq-validate-assign)

actor "Avocat /\nadmin cabinet" as Av
participant "API\n/api/plaidoirie-templates" as API
database PostgreSQL
participant "Redis pub/sub\n+ WebSocket" as RT
participant "E-mail" as Mail
actor "Assistant\njuridique" as As

alt Valider seule
  Av -> API : POST /drafts/{id}/validate
  API -> PostgreSQL : status = validated
  API -> PostgreSQL : CabinetNotification (assistants)
  API -> RT : publish_cabinet_event
  API -> Mail : send_plea_validated_email (si configuré)
else Assigner
  Av -> API : POST /drafts/{id}/assign
  API -> PostgreSQL : assigned_to_user_id\n(+ status=validated si besoin)
  API -> RT : événement temps réel
end

RT --> As : rafraîchir liste
As -> API : GET /drafts (filtrés validated|finalized)
As -> API : POST /export-docx ou /export-pdf
opt Après export (UI avocat)
  Av -> API : PATCH /drafts/{id} (status=finalized)
end
@enduml
